{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vitest/no-disabled-tests": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/jsx-key": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/click-events-have-key-events": "error"
  },
  "overrides": [
    {
      "files": ["src/components/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useState", "useEffect", "useReducer", "useLayoutEffect", "useRef"],
                "message": "Team components are presentational: state and effects belong in routes or hooks (the boss's code)."
              },
              {
                "name": "react-router",
                "importNames": ["useSearchParams", "useNavigate", "useLoaderData"],
                "message": "Team components get data and callbacks through props, not from the router."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "design"]
}
